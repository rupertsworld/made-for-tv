{
  "name": "tv-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "node scripts/test.mjs",
    "frames": "cd frames && ../node_modules/.bin/frameset"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.9.1",
    "frameset": "0.17.1",
    "jsdom": "^27.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
