---
title: tv-code
description: A small project in the file tree, with code, Markdown and image views. Press Ctrl+P or Cmd+P to try the finder.
params:
  scheme: { enum: [light, dark], default: light }
  width: { enum: [wide, narrow], default: wide }
  open: { enum: [code, markdown, image], default: code }
imports:
  - ../spec/tv-code/style.css
  - ../spec/tv-markdown/style.css
  - ../skills/tv-code/tv-code.js
style: |
  body { margin: 0; }
  .page { box-sizing: border-box; min-height: 100vh; padding: 24px; color-scheme: light; background: Canvas; }
  .page[data-scheme="dark"] { color-scheme: dark; }
  .page tv-code { box-sizing: border-box; height: min(720px, calc(100dvh - 48px)); min-height: 400px; border: 1px solid color-mix(in srgb, CanvasText 15%, transparent); border-radius: 8px; }
  .page[data-width="wide"] tv-code { max-width: 1080px; }
  .page[data-width="narrow"] tv-code { max-width: 390px; }
---
<div class="page" data-scheme="{{ scheme }}" data-width="{{ width }}">
<tv-code label="daybook" selected="{% if open == "code" %}src/main.ts{% elsif open == "markdown" %}README.md{% else %}assets/cover.svg{% endif %}">
  <tv-code-file path="README.md" modified="2026-09-29T16:00:00Z">
    # Daybook

    A small timeline for field notes. Entries are kept in date order and rendered in the browser.

    ![A landscape cover for Daybook](assets/cover.svg)

    ## Start

    Install packages, then run the local preview:

    ```sh
    npm install
    npm run dev
    ```

    The timeline lives in [src/main.ts](src/main.ts). Dates are formatted in [src/lib/date.ts](src/lib/date.ts).
  </tv-code-file>
  <tv-code-folder path="src">
    <tv-code-file path="main.ts" modified="2026-09-30T10:20:00Z">
      import { readableDate } from "./lib/date";
      import "./styles.css";

      type Entry = { title: string; createdAt: string };

      const entries: Entry[] = [
        { title: "First light", createdAt: "2026-09-12" },
        { title: "North ridge", createdAt: "2026-09-18" },
        { title: "After the rain", createdAt: "2026-09-27" },
      ];

      export function renderTimeline(root: HTMLElement): void {
        const list = document.createElement("ol");
        for (const entry of entries) {
          const item = document.createElement("li");
          item.textContent = `${entry.title} · ${readableDate(entry.createdAt)}`;
          list.append(item);
        }
        root.replaceChildren(list);
      }

      renderTimeline(document.querySelector("#app")!);
    </tv-code-file>
    <tv-code-folder path="lib">
      <tv-code-file path="date.ts">
        export function readableDate(value: string): string {
          return new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(value));
        }
      </tv-code-file>
    </tv-code-folder>
    <tv-code-file path="styles.css">
      body {
        max-width: 48rem;
        margin: 0 auto;
        font-family: system-ui, sans-serif;
      }

      li { padding-block: 0.75rem; }
    </tv-code-file>
  </tv-code-folder>
  <tv-code-folder path="assets">
    <tv-code-file path="cover.svg">
      &lt;svg xmlns="http://www.w3.org/2000/svg" width="640" height="360" viewBox="0 0 640 360"&gt;
        &lt;rect width="640" height="360" fill="#122e3a" /&gt;
        &lt;circle cx="503" cy="90" r="35" fill="#f9b663" /&gt;
        &lt;path d="M0 286 109 200l68 42 103-109 92 77 60-49 208 118v81H0Z" fill="#387a80" /&gt;
        &lt;path d="M0 320 118 252l94 55 118-78 132 95 84-51 94 36v51H0Z" fill="#73a793" /&gt;
        &lt;text x="34" y="63" font-family="sans-serif" font-size="32" font-weight="700" fill="#ffffff"&gt;Daybook&lt;/text&gt;
      &lt;/svg&gt;
    </tv-code-file>
  </tv-code-folder>
  <tv-code-file path="package.json">
    {
      "name": "daybook",
      "private": true,
      "scripts": { "dev": "vite", "build": "vite build" },
      "dependencies": { "vite": "^7.0.0" }
    }
  </tv-code-file>
</tv-code>
</div>
